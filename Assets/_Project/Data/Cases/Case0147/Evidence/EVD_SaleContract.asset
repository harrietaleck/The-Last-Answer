    requiresExamined: []
    requiresFacts: []
    hiddenUntilAvailable: 0
    lockedPrompt: Look through paperwork
    lockedHint: Loose paperwork from the firm. Read the case file first so you know
      what matters.
  connections:
  - other: {fileID: 11400000, guid: 16441292d66bc854e8b10de759925194, type: 2}
    explanation: The case file names Marlowe as Reyes's partner. If the sale went
      through, Calder Holdings would review his position. He stood to lose the firm
      he co-founded.
    establishesFact: {fileID: 11400000, guid: f52a4a2e757693a459496afe385dc39c, type: 2}
