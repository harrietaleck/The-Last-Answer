  conclusions:
  - conclusionId: CON_ChargeMarlowe
    title: Charge Elliot Marlowe with murder
    description: Reyes's partner of eighteen years. Make sure you can prove he was
      there, and why.
    accused: {fileID: 11400000, guid: f074a42f5aec06348bdd8190fbe4c43e, type: 2}
  - conclusionId: CON_ChargeKim
    title: Charge Victor Kim with murder
    description: The junior architect Reyes fired two weeks ago, whose key card was
      never cancelled.
    accused: {fileID: 11400000, guid: f1e8a9631610e3d4cba16b732c2167de, type: 2}
  - conclusionId: CON_ChargeHayes
    title: Charge Nora Hayes with murder
    description: The office manager who found the body and called it in.
    accused: {fileID: 11400000, guid: fd82df173c88f8141b94b4261c8dc510, type: 2}
  - conclusionId: CON_NoCharge
    title: Charge no one
    description: Not enough evidence to charge anyone. Marlowe goes home and the
      case stays open.
    accused: {fileID: 0}
