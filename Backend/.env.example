# Copy to .env (never commit .env) or set these in your hosting dashboard.
# The game never sees any of these values.

PORT=8787
# 127.0.0.1 = only this computer can connect. Hosting platforms set this for you.
HOST=127.0.0.1

# Which adapter in providers/ to use. "stub" needs no account and costs nothing.
TLA_PROVIDER=stub

# Secret for the AI service, once one is chosen. Server-side only.
TLA_AI_API_KEY=
# Model id for the chosen service (kept here so it's never hardcoded in code).
TLA_AI_MODEL=

TLA_RATE_LIMIT_PER_MINUTE=30

# Testing only: slow | error | invalid | wrongid | invent | ratelimit
TLA_FAULT=
